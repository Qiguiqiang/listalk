<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>update-harness</AssemblyName>
    <RootNamespace>UpdateHarness</RootNamespace>
  </PropertyGroup>
  <!-- Compile the SHIPPED sources, not copies (task 4). -->
  <ItemGroup>
    <Compile Include="..\..\windows-native\AirBridge\Update.cs" Link="Update.cs" />
    <Compile Include="..\..\windows-native\AirBridge\LoopDetector.cs" Link="LoopDetector.cs" />
    <Compile Include="..\..\windows-native\AirBridge\AudioService.cs" Link="AudioService.cs" />
    <Compile Include="..\..\windows-native\AirBridge\BridgeEngine.cs" Link="BridgeEngine.cs" />
    <Compile Include="..\..\windows-native\AirBridge\Core.cs" Link="Core.cs" />
    <Compile Include="..\..\windows-native\AirBridge\Protocol.cs" Link="Protocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
</Project>
