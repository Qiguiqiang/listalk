<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AirBridge"
        x:Class="AirBridge.MainWindow"
        Title="声音接力 SoundRelay"
        Width="1160" Height="680"
        MinWidth="940" MinHeight="580"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{StaticResource Bg}">
  <!-- Desktop UI per UI_SPEC_DESKTOP.md / preview_desktop.html (approved prototype):
       custom title bar 40px + sidebar 232px + main area with Device / Discover /
       Settings / About pages + in-window update modal overlay. -->
  <Grid RowDefinitions="40,*">

    <!-- ===== custom title bar ===== -->
    <Border Name="titleBar" Grid.Row="0" Background="{StaticResource BgTop}"
            BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="9" Margin="14,0,0,0" VerticalAlignment="Center">
          <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource LogoTileGradient}"
                  BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
              <Border Width="2.5" Height="6" CornerRadius="1.2" Background="{StaticResource BarGradient}"/>
              <Border Width="2.5" Height="11" CornerRadius="1.2" Background="{StaticResource BarGradient}"/>
              <Border Width="2.5" Height="8" CornerRadius="1.2" Background="{StaticResource BarGradient}"/>
            </StackPanel>
          </Border>
          <TextBlock Text="声音接力 SoundRelay" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}" VerticalAlignment="Center"/>
          <TextBlock Name="tbMachine" Text="· 本机" FontSize="12.5" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Name="btnMin" Classes="wctl" ToolTip.Tip="最小化">
            <Path Data="M0,5.5 L11,5.5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.1" Width="11" Height="11" Stretch="Uniform"/>
          </Button>
          <Button Name="btnMax" Classes="wctl" ToolTip.Tip="最大化 / 还原">
            <Border Width="10" Height="10" BorderBrush="{Binding $parent[Button].Foreground}" BorderThickness="1.1"/>
          </Button>
          <Button Name="btnCloseWin" Classes="wctl close" ToolTip.Tip="关闭到托盘">
            <Path Data="M1,1 L10,10 M10,1 L1,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.1" Width="11" Height="11" Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== body ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="232,*">

      <!-- ===== sidebar ===== -->
      <Border Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,18,12,14">
          <StackPanel DockPanel.Dock="Top">
            <Grid ColumnDefinitions="Auto,*" Margin="8,2,8,0">
              <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource LogoTileGradient}"
                      BorderBrush="{StaticResource StrokeHi}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                  <Border Width="4" Height="10" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                  <Border Width="4" Height="19" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                  <Border Width="4" Height="26" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                  <Border Width="4" Height="15" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                  <Border Width="4" Height="9" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="声音接力" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text1}"/>
                <TextBlock Text="SOUNDRELAY" FontSize="10.5" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{StaticResource Stroke}" Margin="8,16,8,14"/>
            <StackPanel Spacing="3">
              <Button Name="navDevice" Classes="nav on">
                <Grid ColumnDefinitions="3,Auto,*,Auto">
                  <Border Name="navDeviceBar" Width="3" CornerRadius="1.5" Background="{StaticResource Accent}" Margin="-10,1,7,1"/>
                  <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconPhone}" Stroke="{Binding $parent[Button].Foreground}" Width="17" Height="17" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="设备" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Name="navSettings" Classes="nav">
                <Grid ColumnDefinitions="3,Auto,*,Auto">
                  <Border Name="navSettingsBar" Width="3" CornerRadius="1.5" Background="{StaticResource Accent}" Margin="-10,1,7,1" IsVisible="False"/>
                  <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconGear}" Stroke="{Binding $parent[Button].Foreground}" Width="17" Height="17" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="设置" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Name="navUpdate" Classes="nav">
                <Grid ColumnDefinitions="3,Auto,*,Auto">
                  <Border Name="navUpdateBar" Width="3" CornerRadius="1.5" Background="{StaticResource Accent}" Margin="-10,1,7,1" IsVisible="False"/>
                  <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconDownload}" Stroke="{Binding $parent[Button].Foreground}" Width="17" Height="17" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="更新" Margin="11,0,0,0" VerticalAlignment="Center"/>
                  <Ellipse Name="navUpdateDot" Grid.Column="3" Width="7" Height="7" Fill="{StaticResource Error}" VerticalAlignment="Center" IsVisible="False"/>
                </Grid>
              </Button>
              <Button Name="navAbout" Classes="nav">
                <Grid ColumnDefinitions="3,Auto,*,Auto">
                  <Border Name="navAboutBar" Width="3" CornerRadius="1.5" Background="{StaticResource Accent}" Margin="-10,1,7,1" IsVisible="False"/>
                  <Path Grid.Column="1" Classes="icon" Data="{StaticResource IconInfo}" Stroke="{Binding $parent[Button].Foreground}" Width="17" Height="17" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="关于" Margin="11,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock Name="navAboutVer" Grid.Column="3" Text="v2.2.1" Classes="mono" FontSize="11" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="11" Padding="12,10" Margin="2,0,2,12">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <local:PulseDot Name="sidePulse" Width="16" Height="16" VerticalAlignment="Center"/>
                  <TextBlock Name="sideConnTitle" Text="未连接" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Name="sideConnSub" Text="等待手机连接" Classes="mono" FontSize="11.5" Foreground="{StaticResource Text2}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Grid Margin="6,0,0,0">
              <TextBlock Name="sideVersion" Text="v2.2.1" Classes="mono" FontSize="11.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
              <Button Name="btnSideUpdate" Content="有新版本" FontSize="11" FontWeight="SemiBold"
                      Background="{StaticResource Warn}" Foreground="{StaticResource Bg}"
                      CornerRadius="999" Padding="9,2.5" BorderThickness="0"
                      HorizontalAlignment="Right" IsVisible="False"/>
            </Grid>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ===== main area: pages ===== -->
      <Panel Grid.Column="1">

        <!-- ========== PAGE: DEVICE ========== -->
        <Grid Name="pageDevice" RowDefinitions="46,Auto,*">
          <Border Background="#73151B24" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <local:PulseDot Name="devPulse" Width="16" Height="16" VerticalAlignment="Center"/>
                  <TextBlock Name="devStatusWord" Text="未连接" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text1}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Width="1" Height="18" Background="{StaticResource Stroke}"/>
                <TextBlock Name="devStatusInfo1" Text="" Classes="mono" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                <Border Width="1" Height="18" Background="{StaticResource Stroke}"/>
                <TextBlock Name="devStatusInfo2" Text="断线会自动重连" Classes="mono" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Classes="chip">
                  <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Text2}"><Run Text="UDP · "/><Run Text="10 ms" FontWeight="Bold" Foreground="{StaticResource Text1}"/><Run Text=" 帧"/></TextBlock>
                </Border>
                <Border Classes="chip">
                  <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Text2}"><Run Text="端口 "/><Run Name="tbPortRun" Text="47731" FontWeight="Bold" Foreground="{StaticResource Text1}"/></TextBlock>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Grid.Row="1" Margin="22,10,22,0" Spacing="8">
            <Border Name="bannerInfo" Background="{StaticResource AccentDim}" CornerRadius="9" Padding="12,8" IsVisible="False">
              <TextBlock Name="tvBanner" Text="" FontSize="13" Foreground="{StaticResource Accent}"/>
            </Border>
            <Border Name="bannerLoop" Background="{StaticResource ErrorDim}" CornerRadius="9" Padding="12,8" IsVisible="False">
              <TextBlock Name="tvLoopWarn" Text="" FontSize="13" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
            </Border>
            <Border Name="bannerVersion" Background="#1FFFB224" CornerRadius="9" Padding="12,8" IsVisible="False">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="tvVersionWarn" Text="" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Warn}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Name="btnVersionUpdate" Grid.Column="1" Classes="btn sm" Content="打开更新检查" Margin="10,0,0,0"/>
              </Grid>
            </Border>
          </StackPanel>

          <ScrollViewer Grid.Row="2">
            <StackPanel Margin="22,20,22,22">
              <!-- hero: connected -->
              <Border Name="hero" Classes="hero" Padding="22,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="icoblock" Width="52" Height="52" CornerRadius="13" VerticalAlignment="Top">
                    <Path Classes="icon" Data="{StaticResource IconPhone}" Stroke="{StaticResource Text2}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Name="heroEyebrow" Text="● LIVE · 已连接手机" Classes="eyebrow" Foreground="{StaticResource Accent}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <TextBlock Name="heroName" Text="" Classes="h19"/>
                      <Border Name="latBadge" CornerRadius="999" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center"
                              Background="{StaticResource AccentDim}" BorderBrush="#592CE8A5" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Name="latNum" Text="--" Classes="mono" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                          <TextBlock Name="latWord" Text=" ms" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <TextBlock Name="heroSub" Text="" Classes="mono" FontSize="12.5" Foreground="{StaticResource Text2}" Margin="0,5,0,0"/>
                    <WrapPanel Margin="0,13,0,0">
                      <Border Classes="chip" Margin="0,0,8,0">
                        <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Text2}"><Run Text="采样率 "/><Run Name="tbChipRate" Text="48 kHz" FontWeight="Bold" Foreground="{StaticResource Text1}"/></TextBlock>
                      </Border>
                      <Border Classes="chip" Margin="0,0,8,0">
                        <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Text2}"><Run Text="回声消除 "/><Run Text="手机端" FontWeight="Bold" Foreground="{StaticResource Text1}"/></TextBlock>
                      </Border>
                      <Border Name="chipMismatch" Classes="chip" IsVisible="False">
                        <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Warn}" Text="版本不一致 · 请先更新手机端"/>
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                  <Button Name="btnDisconnect" Grid.Column="2" Classes="btn disc" Content="断开连接" VerticalAlignment="Top"/>
                </Grid>
              </Border>
              <!-- hero: empty state -->
              <Border Name="heroEmpty" Classes="hero" Padding="22,20" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="icoblock" Width="52" Height="52" CornerRadius="13" VerticalAlignment="Top">
                    <Path Classes="icon" Data="{StaticResource IconPhone}" Stroke="{StaticResource Text2}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Name="heroEmptyTitle" Text="等待手机连接" Classes="h19"/>
                    <TextBlock Name="heroEmptyDesc" Text="在手机上打开声音接力即可自动找到这台电脑" Classes="desc" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="8">
                    <Button Name="btnGotoDiscover" Classes="btn pri" Content="查看附近设备"/>
                    <Button Name="btnStartService" Classes="btn" Content="启动服务" IsVisible="False"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- stats strip -->
              <Border Classes="card" CornerRadius="12" Margin="0,14,0,0">
                <Grid ColumnDefinitions="*,1,*,1,*,1,*,1,*">
                  <StackPanel Margin="16,11">
                    <TextBlock Text="丢包率" FontSize="11" Foreground="{StaticResource Text3}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock Name="statLoss" Text="--" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}"/>
                      <TextBlock Text=" %" FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="1" Background="{StaticResource Stroke}"/>
                  <StackPanel Grid.Column="2" Margin="16,11">
                    <TextBlock Text="抖动" FontSize="11" Foreground="{StaticResource Text3}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock Name="statJitter" Text="--" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}"/>
                      <TextBlock Text=" ms" FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="3" Background="{StaticResource Stroke}"/>
                  <StackPanel Grid.Column="4" Margin="16,11">
                    <TextBlock Text="抖动缓冲" FontSize="11" Foreground="{StaticResource Text3}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock Name="statBuffer" Text="--" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}"/>
                      <TextBlock Name="statBufferNote" Text=" ms · 自适应" FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="5" Background="{StaticResource Stroke}"/>
                  <StackPanel Grid.Column="6" Margin="16,11">
                    <TextBlock Text="上行（麦克风）" FontSize="11" Foreground="{StaticResource Text3}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock Name="statUp" Text="--" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}"/>
                      <TextBlock Text=" kbps" FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="7" Background="{StaticResource Stroke}"/>
                  <StackPanel Grid.Column="8" Margin="16,11">
                    <TextBlock Text="下行（扬声器）" FontSize="11" Foreground="{StaticResource Text3}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock Name="statDown" Text="--" Classes="mono" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}"/>
                      <TextBlock Text=" kbps" FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- sparkline -->
              <Border Classes="card" CornerRadius="12" Margin="0,14,0,0" Padding="16,12,16,8">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="延迟 · 近 60 秒" FontSize="11" Foreground="{StaticResource Text3}"/>
                    <TextBlock Name="sparkNow" Text="当前 -- ms" Classes="mono" FontSize="11" Foreground="{StaticResource Text3}" HorizontalAlignment="Right"/>
                  </Grid>
                  <local:Sparkline Name="spark" Height="44" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <!-- channels -->
              <Grid Margin="2,22,2,12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="音频通道" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text1}"/>
                </StackPanel>
                <TextBlock Text="两条通道可独立开关" FontSize="11.5" Foreground="{StaticResource Text3}" HorizontalAlignment="Right"/>
                <Border Height="1" Background="{StaticResource Stroke}" Margin="86,0,150,0" VerticalAlignment="Center"/>
              </Grid>
              <Grid Name="chanGrid" ColumnDefinitions="*,*">
                <!-- mic channel -->
                <Border Name="cardMic" Classes="card" Padding="18,16" Margin="0,0,7,0">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentDim}">
                        <Path Classes="icon" Data="{StaticResource IconMic}" Stroke="{StaticResource Accent}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="麦克风 → 电脑" Classes="cardt"/>
                        <TextBlock Text="手机的声音送到电脑，当麦克风用" Classes="desc115" Margin="0,1,0,0"/>
                      </StackPanel>
                      <local:SwitchControl Name="swMic" Grid.Column="2" Width="42" Height="24" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                      <TextBlock Text="MIC LEVEL" Classes="eyebrow"/>
                      <TextBlock Name="dbMic" Text="— dB" Classes="mono" FontSize="11.5" Foreground="{StaticResource Text2}" HorizontalAlignment="Right"/>
                    </Grid>
                    <local:SegmentMeter Name="meterMic" Height="16" Margin="0,6,0,0" ChannelBrush="{StaticResource Accent}"/>
                    <TextBlock Text="输出到电脑的设备（软件在这里选手机麦克风）" FontSize="11" Foreground="{StaticResource Text3}" Margin="0,14,0,5"/>
                    <Button Name="pickOutBtn" Background="{StaticResource SurfaceIn}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="9" Padding="11,8" HorizontalContentAlignment="Stretch">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Name="pickOutName" Text="—" FontSize="12.5" Foreground="{StaticResource Text1}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Border Name="pickOutTag" Grid.Column="1" CornerRadius="999" Padding="8,2" Background="{StaticResource AccentDim}" Margin="8,0,0,0">
                          <TextBlock Name="pickOutTagText" Text="声音接力设备" FontSize="10.5" Foreground="{StaticResource Accent}"/>
                        </Border>
                        <Path Grid.Column="2" Data="{StaticResource IconChevron}" Stroke="{StaticResource Text2}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                      </Grid>
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel Name="pickOutList" Spacing="2" MinWidth="340"/>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <TextBlock Name="tvOutBadge" Text="" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <!-- speaker channel -->
                <Border Name="cardSpk" Classes="card" Padding="18,16" Margin="7,0,0,0" Grid.Column="1">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource SkyDim}">
                        <Path Classes="icon" Data="{StaticResource IconSpeaker}" Stroke="{StaticResource Sky}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="电脑 → 扬声器" Classes="cardt"/>
                        <TextBlock Text="电脑的声音送到手机播放" Classes="desc115" Margin="0,1,0,0"/>
                      </StackPanel>
                      <local:SwitchControl Name="swSpk" Grid.Column="2" Width="42" Height="24" Variant="Sky" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                      <TextBlock Text="SPEAKER LEVEL" Classes="eyebrow"/>
                      <TextBlock Name="dbSpk" Text="— dB" Classes="mono" FontSize="11.5" Foreground="{StaticResource Text2}" HorizontalAlignment="Right"/>
                    </Grid>
                    <local:SegmentMeter Name="meterSpk" Height="16" Margin="0,6,0,0" ChannelBrush="{StaticResource Sky}"/>
                    <TextBlock Text="采集电脑上的哪个声音送到手机" FontSize="11" Foreground="{StaticResource Text3}" Margin="0,14,0,5"/>
                    <Button Name="pickInBtn" Background="{StaticResource SurfaceIn}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="9" Padding="11,8" HorizontalContentAlignment="Stretch">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Name="pickInName" Text="—" FontSize="12.5" Foreground="{StaticResource Text1}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Border Name="pickInTag" Grid.Column="1" CornerRadius="999" Padding="8,2" Background="{StaticResource SkyDim}" Margin="8,0,0,0">
                          <TextBlock Name="pickInTagText" Text="声音接力设备" FontSize="10.5" Foreground="{StaticResource Sky}"/>
                        </Border>
                        <Path Grid.Column="2" Data="{StaticResource IconChevron}" Stroke="{StaticResource Text2}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                      </Grid>
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel Name="pickInList" Spacing="2" MinWidth="340"/>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <TextBlock Name="tvInBadge" Text="" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,13,0,0">
                      <TextBlock Text="手机音量" FontSize="11" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                      <Slider Name="volSlider" Grid.Column="1" Classes="volslider" Minimum="0" Maximum="100" Margin="10,0" VerticalAlignment="Center"/>
                      <TextBlock Name="volVal" Grid.Column="2" Text="70%" Classes="mono" FontSize="11.5" Foreground="{StaticResource Text2}" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="关闭窗口将最小化到系统托盘，推流不会中断 · 在手机上也能断开这台电脑"
                         FontSize="11.5" Foreground="{StaticResource Text3}" TextAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ========== PAGE: DISCOVER ========== -->
        <Grid Name="pageDiscover" RowDefinitions="46,*" IsVisible="False">
          <Border Background="#73151B24" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource Text3}" VerticalAlignment="Center"/>
                  <TextBlock Text="设备发现" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Width="1" Height="18" Background="{StaticResource Stroke}"/>
                <TextBlock Text="同一局域网内自动发现，无需输 IP" Classes="mono" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
              </StackPanel>
              <Button Name="btnRescan" Classes="btn sm ghost" Content="重新扫描" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="22,20,22,22">
              <Grid>
                <Rectangle Fill="{StaticResource Surface}" Stroke="{StaticResource StrokeHi}" StrokeThickness="1"
                           StrokeDashArray="5,4" RadiusX="13" RadiusY="13"/>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,13">
                  <local:Spinner Width="34" Height="34" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="正在扫描附近的手机…" Classes="t135"/>
                    <TextBlock Name="tbScanInfo" Text="通过局域网广播、mDNS 与蓝牙近感三路并行查找" Classes="desc115" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
                    <TextBlock Name="tbLocalChip" Text="本机" Classes="mono" FontSize="11.5" Foreground="{StaticResource Text2}"/>
                  </Border>
                </Grid>
              </Grid>

              <Border Name="verifyBar" Background="{StaticResource AccentDim}" CornerRadius="9" Padding="12,8" Margin="0,12,0,0" IsVisible="False">
                <TextBlock Name="tvVerify" Text="" FontSize="13" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
              </Border>

              <Grid Margin="2,18,2,12">
                <TextBlock Text="已配对设备" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text1}"/>
                <TextBlock Text="配对过一次，之后自动识别" FontSize="11.5" Foreground="{StaticResource Text3}" HorizontalAlignment="Right"/>
              </Grid>
              <StackPanel Name="pairedList" Spacing="10"/>
              <TextBlock Name="pairedEmpty" Text="（暂无已配对手机）" Classes="desc" IsVisible="False"/>

              <Grid Margin="2,22,2,12">
                <TextBlock Text="附近的新设备" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text1}"/>
              </Grid>
              <StackPanel Name="nearbyList" Spacing="10"/>
              <TextBlock Name="nearbyEmpty" Text="暂无新设备 · 让手机打开声音接力并连上同一 WiFi" Classes="desc" IsVisible="False"/>

              <Border Classes="card" Padding="16" Margin="0,16,0,0">
                <Grid ColumnDefinitions="Auto,*">
                  <Image Name="imgQr" Width="140" Height="140"/>
                  <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="其他配对方式（次选）" Classes="cardt"/>
                    <TextBlock Text="扫码或在手机上输入配对码 —— 附近发现是主路径，这两个是兜底。" Classes="desc" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="配对码" Classes="desc" Margin="0,10,0,0"/>
                    <TextBlock Name="tvPairCode" Text="------" Classes="mono" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock Name="tvPairCountdown" Text="" Classes="desc" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock Text="配对时手机上会弹出确认，核对两端显示的 6 位配对码一致即可 · 扫码与手动输入 IP 在手机端「其他方式」里"
                         FontSize="11.5" Foreground="{StaticResource Text3}" TextAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ========== PAGE: SETTINGS ========== -->
        <Grid Name="pageSettings" RowDefinitions="46,*" IsVisible="False">
          <Border Background="#73151B24" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="22,0" VerticalAlignment="Center">
              <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
              <Border Width="1" Height="18" Background="{StaticResource Stroke}"/>
              <TextBlock Text="修改即时生效，无需重启" Classes="mono" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="22,20,22,22">
              <!-- group: connection -->
              <Border Classes="card" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="连接与重连" Classes="grouphead" Margin="18,13,18,4"/>
                  <Border BorderBrush="#8C26303F" BorderThickness="0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="手机回到附近时" Classes="t135"/>
                        <TextBlock Text="离开超过 10 分钟再回来时的处理方式；短暂掉线（60 秒内）始终自动续连，不受此项影响" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <local:SegmentedControl Name="segReconnect" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="开机自动启动" Classes="t135"/>
                        <TextBlock Text="登录 Windows 后在托盘静默启动，不弹窗" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <local:SwitchControl Name="swAutoStart" Grid.Column="1" Width="38" Height="22" Small="True" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="关闭窗口时最小化到托盘" Classes="t135"/>
                        <TextBlock Text="关掉窗口不退出，服务和推流继续；从托盘菜单可彻底退出" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <local:SwitchControl Name="swCloseToTray" Grid.Column="1" Width="38" Height="22" Small="True" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <!-- group: audio -->
              <Border Classes="card" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="音频" Classes="grouphead" Margin="18,13,18,4"/>
                  <Border BorderBrush="#8C26303F" BorderThickness="0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="回声消除" Classes="t135"/>
                        <TextBlock Text="手机外放电脑声音时，消除被手机麦克风收回去的回声（手机端处理）" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Border Grid.Column="1" CornerRadius="999" Padding="9,2.5" Background="{StaticResource AccentDim}" VerticalAlignment="Center">
                        <TextBlock Text="手机端处理 · 已启用" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                      </Border>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="采样率策略" Classes="t135"/>
                        <TextBlock Text="网络变差时自动降低采样率保流畅，恢复后自动升回" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <local:SegmentedControl Name="segRate" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="声音接力虚拟音频设备" Classes="t135"/>
                        <TextBlock Name="tvVdevDesc" Text="正在检测…" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Border Name="pillVdev" Grid.Column="1" CornerRadius="999" Padding="9,2.5" Background="{StaticResource AccentDim}" VerticalAlignment="Center">
                        <TextBlock Name="pillVdevText" Text="检测中" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <!-- group: update -->
              <Border Classes="card" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="更新" Classes="grouphead" Margin="18,13,18,4"/>
                  <Border BorderBrush="#8C26303F" BorderThickness="0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="自动检查更新" Classes="t135"/>
                        <TextBlock Name="tvUpdDesc" Text="当前版本 v2.2.1 · 发现新版本时在侧边栏提醒" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <local:SwitchControl Name="swAutoCheck" Width="38" Height="22" Small="True" VerticalAlignment="Center"/>
                        <Button Name="btnCheckUpdate" Classes="btn sm" Content="检查更新"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="更新地址" Classes="t135"/>
                        <TextBlock Text="更新包来源；将来可改为你自己的服务器" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBox Name="txtUpdateUrl" Grid.Column="1" Classes="mono-input" Width="340" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="更新状态" Classes="t135"/>
                        <TextBlock Name="tvUpdateStatus" Text="尚未检查" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="手机与电脑版本一致性" Classes="t135"/>
                        <TextBlock Text="两端同版本成套更新；版本不一致时连接会明确提示先更新哪一端，不会静默失败" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Border Name="pillVersions" Grid.Column="1" CornerRadius="999" Padding="9,2.5" Background="{StaticResource AccentDim}" VerticalAlignment="Center">
                        <TextBlock Name="pillVersionsText" Text="未连接" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <!-- group: notifications -->
              <Border Classes="card" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="通知" Classes="grouphead" Margin="18,13,18,4"/>
                  <Border BorderBrush="#8C26303F" BorderThickness="0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="连接状态通知" Classes="t135"/>
                        <TextBlock Text="手机连接、断开、重连成功时更新托盘提示" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <local:SwitchControl Name="swNotifications" Grid.Column="1" Width="38" Height="22" Small="True" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="回归询问通知" Classes="t135"/>
                        <TextBlock Text="手机离开后重新出现时，弹通知询问是否连接（跟随上方重连模式）" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <local:SwitchControl Name="swReturnAsk" Grid.Column="1" Width="38" Height="22" Small="True" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <!-- group: diagnostics (existing functions kept; not in prototype) -->
              <Border Classes="card" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="诊断" Classes="grouphead" Margin="18,13,18,4"/>
                  <Border BorderBrush="#8C26303F" BorderThickness="0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="桥接服务" Classes="t135"/>
                        <TextBlock Name="tvSvcDesc" Text="服务运行中 · 关闭窗口将最小化到托盘（可在设置里关掉）" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Name="btnPause" Classes="btn sm" Content="暂停桥接"/>
                        <Button Name="btnToggleService" Classes="btn sm" Content="停止服务"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="发现层状态" Classes="t135"/>
                        <TextBlock Name="tvDiscoveryStatus" Text="" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Button Name="btnRefreshDevices" Grid.Column="1" Classes="btn sm" Content="刷新设备列表" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <StackPanel>
                      <TextBlock Text="运行日志" Classes="t135"/>
                      <TextBox Name="txtLog" Classes="logbox" Height="110" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Name="tbSetFoot" Text="声音接力 SoundRelay · 设置保存在本机，不上传任何数据"
                         FontSize="11.5" Foreground="{StaticResource Text3}" TextAlignment="Center"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ========== PAGE: ABOUT ========== -->
        <Grid Name="pageAbout" RowDefinitions="46,*" IsVisible="False">
          <Border Background="#73151B24" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="22,0" VerticalAlignment="Center">
              <TextBlock Text="关于" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1">
            <StackPanel Margin="22,20,22,22">
              <Border Classes="card" Padding="22,20">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="52" Height="52" CornerRadius="13" Background="{StaticResource LogoTileGradient}"
                          BorderBrush="{StaticResource StrokeHi}" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                      <Border Width="4" Height="12" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                      <Border Width="4" Height="24" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                      <Border Width="4" Height="32" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                      <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                      <Border Width="4" Height="10" CornerRadius="2" Background="{StaticResource BarGradient}"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="声音接力 SoundRelay" Classes="h19"/>
                    <TextBlock Text="让声音在电脑、手机和耳机之间自由接力" Classes="desc" FontSize="12.5" Margin="0,5,0,0"/>
                    <TextBlock Name="tbAboutVer" Text="版本 v2.2.1 · Windows 版" Classes="mono" FontSize="12" Foreground="{StaticResource Text3}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="card" Margin="0,14,0,0">
                <StackPanel>
                  <Border BorderBrush="#8C26303F" BorderThickness="0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="传输协议" Classes="t135"/>
                        <TextBlock Text="局域网 UDP 直连，不经任何服务器，声音数据不出本地网络" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock Name="tbAboutProto" Text="UDP · 47731 · PCM16 · 协议 v2" Classes="mono" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="虚拟音频设备" Classes="t135"/>
                        <TextBlock Name="tvAboutVdev" Text="正在检测…" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="本机" Classes="t135"/>
                        <TextBlock Name="tvAboutLocal" Text="" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border BorderBrush="#8C26303F" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="开源许可" Classes="t135"/>
                        <TextBlock Text="Apache License 2.0 · 免费供所有人使用" Classes="desc115" LineHeight="17" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock Text="github.com/Qiguiqiang/soundrelay" Classes="mono" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Panel>
    </Grid>

    <!-- ===== update modal overlay ===== -->
    <Border Name="updateScrim" Grid.RowSpan="2" Background="#A804060A" IsVisible="False">
      <Border Width="440" Background="{StaticResource ModalBg}" BorderBrush="{StaticResource StrokeHi}" BorderThickness="1"
              CornerRadius="16" Padding="26,24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentDim}">
              <Path Classes="icon" Data="{StaticResource IconDownload}" Stroke="{StaticResource Accent}" Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
              <TextBlock Name="modalTitle" Text="发现新版本" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text1}"/>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Name="modalVerFrom" Text="v2.2.1" Classes="mono" FontSize="12" Foreground="{StaticResource Text2}"/>
                <TextBlock Text=" → " Classes="mono" FontSize="12" Foreground="{StaticResource Text2}"/>
                <TextBlock Name="modalVerTo" Text="v2.2.1" Classes="mono" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Warn}"/>
                <TextBlock Name="modalVerExtra" Text="" Classes="mono" FontSize="12" Foreground="{StaticResource Text2}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <Border Name="modalNotesBox" Background="{StaticResource SurfaceIn}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                  CornerRadius="11" Padding="15,12" Margin="0,16,0,0">
            <TextBlock Name="modalNotes" Text="" FontSize="12.5" Foreground="{StaticResource Text2}" LineHeight="21" TextWrapping="Wrap"/>
          </Border>
          <Image Name="modalQr" Width="170" Height="170" HorizontalAlignment="Center" Margin="0,14,0,0" IsVisible="False"/>
          <TextBlock Name="modalQrCap" Text="用手机扫码打开手机端更新页" FontSize="12" Foreground="{StaticResource Text2}"
                     HorizontalAlignment="Center" Margin="0,6,0,0" IsVisible="False"/>
          <StackPanel Name="modalProg" Margin="0,18,0,0" IsVisible="False">
            <Grid>
              <TextBlock Name="modalProgText" Text="正在下载…" FontSize="11.5" Foreground="{StaticResource Text2}"/>
              <TextBlock Name="modalProgPct" Text="0%" Classes="mono" FontSize="11.5" Foreground="{StaticResource Text1}" HorizontalAlignment="Right"/>
            </Grid>
            <Panel Height="7" Margin="0,6,0,0">
              <Border Name="progTrack" Background="{StaticResource SegOff}" CornerRadius="99"/>
              <Border Name="progFill" Background="{StaticResource ProgGradient}" CornerRadius="99" HorizontalAlignment="Left" Width="0"/>
            </Panel>
          </StackPanel>
          <TextBlock Name="modalError" Text="" FontSize="12.5" Foreground="{StaticResource Error}" TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="False"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Name="modalLater" Classes="btn ghost" Content="稍后提醒"/>
            <Button Name="modalClose" Classes="btn" Content="关闭" IsVisible="False"/>
            <Button Name="modalGo" Classes="btn pri" Content="下载并安装"/>
          </StackPanel>
          <TextBlock Name="modalFoot" Text="手机端会同步提示更新，两端同版本才能继续连接。"
                     FontSize="11" Foreground="{StaticResource Text3}" Margin="0,13,0,0"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
