<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AirBridge.App">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AirBridge/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <!-- Design tokens live in Tokens.axaml (single source). They are merged
         here for MainWindow / runtime lookups AND inside Styles.axaml's own
         Styles.Resources: style setters referencing the tokens evaluate
         while Application.Styles is populated, i.e. before this Resources
         dictionary exists, so the styles cannot rely on this merge alone
         (that was the v2.2.x 'Text1/Text3 not found' startup crash). -->
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AirBridge/Tokens.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
